{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "git-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
		},
	},
	// Revocable admin sessions + login-failure counters (src/lib/admin/kv.ts).
	// No `id`: `wrangler deploy` auto-provisions the namespace. To pin an existing
	// one, run `npx wrangler kv namespace create ADMIN_KV` and add its "id" here.
	"kv_namespaces": [
		{
			"binding": "ADMIN_KV",
		},
	],
	// Burst limit for POST /api/admin/login per client IP (src/lib/admin/rate-limit.ts).
	// namespace_id must be a positive integer unique within the Cloudflare account.
	"ratelimits": [
		{
			"name": "ADMIN_LOGIN_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60,
			},
		},
	],
	// Non-secret defaults (override in dashboard if needed).
	// Secrets go in .dev.vars locally / `wrangler secret put` in production:
	// ADMIN_PASSWORD, SESSION_SECRET, GITHUB_TOKEN
	"vars": {
		"GITHUB_REPO": "amberhawker/GIT_web",
		"GITHUB_BRANCH": "main",
	},
}
