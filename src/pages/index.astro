---
import Layout from '../layouts/Layout.astro';
import Event from '../components/Event.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gitLogo from '../assets/GITInit.png';

const allEvents = await getCollection("events");
const featured = allEvents.filter(event => event.data.featured == true);
---

<Layout>
	<div class="hero bg-base-200 min-h-[80vh]">
		<div class="hero-content flex-col lg:flex-row">
			<Image
				alt="Girls in Tech UBC Okanagan"
				src={gitLogo}
				class="max-w-lg w-full rounded-lg shadow-2xl"
			/>
			<div>
			<h1 class="text-5xl font-bold">Girls in Tech!</h1>
			<h2>University of British Columbia - Okanagan</h2>
			<p class="py-6">
				We aim to address the breach between girls in technology-related fields and the opportunities available for them.
			</p>
			<button class="btn btn-primary">Contact Us</button>
			</div>
		</div>
	</div>
	<!-- About us -->
	<div min-h-[50vh] h-[50vh] max-h-screen>
		<div class="text-center">
			<h1 class="text-5xl">About us</h1>
		</div>
		<div class="text-justify mx-20">
			<p>
				SUO Girls in Tech at UBCO provides an inclusive and welcoming space for diversity in technology. We are a student chapter of the Association for Computing Machinery's Council on Women in Computing (ACM-W), located at the University of British Columbia's Okanagan Campus.
			</p>
			<p>
				Throughout the school year, we will be hosting a variety of events for students including career prep activities like resume and LinkedIn reviews, fun socials where we can connect with other students and professionals in the technology field, worshops and programs to build your technical skills, and more! 
			</p>
			<h2 class="">
				We look forward to meeting you and supporting your tech career!
			</h2>
		</div>
	</div>
	<!-- FeaturedEvent component insert -->
	 <div class="min-h-[50vh]">
		<h1 class="text-5xl text-center">Featured Event</h1>
		{featured.map((event) => (
			<Event 
				eventTitle = {event.data.title}
				imgs = {event.data.imgs}
				description = {event.data.description}
			/>
		))}
	 </div>
</Layout>
