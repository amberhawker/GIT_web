---
import Layout from '../layouts/Layout.astro';
import Event from '../components/Event.astro';
import Sponsor from '../components/Sponsor.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gitLogo from '../assets/GITTransparentCrop.png';
const allEvents = await getCollection("events");
const featured = allEvents.filter(event => event.data.featured == true);
const sponsors = await getCollection("sponsors");
---

<Layout>
	<div class="hero bg-base-200 min-h-[82vh] relative overflow-hidden py-10 md:py-16">
		<!-- Decorative Background Retro Sparkles / Stars -->
		<div class="pointer-events-none absolute top-8 left-8 md:top-12 md:left-20 animate-pulse text-primary opacity-80" aria-hidden="true">
			<svg class="w-7 h-7 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
			</svg>
		</div>

		<div class="pointer-events-none absolute bottom-12 left-6 md:bottom-20 md:left-32 animate-pulse text-base-content/40 opacity-70 [animation-delay:700ms]" aria-hidden="true">
			<svg class="w-5 h-5 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
			</svg>
		</div>

		<div class="pointer-events-none absolute top-10 right-10 md:top-14 md:right-24 animate-pulse text-primary opacity-80 [animation-delay:1200ms]" aria-hidden="true">
			<svg class="w-8 h-8 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
			</svg>
		</div>

		<div class="pointer-events-none absolute bottom-8 right-12 md:bottom-16 md:right-1/3 animate-pulse text-base-content/40 opacity-60 [animation-delay:1800ms]" aria-hidden="true">
			<svg class="w-5 h-5 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
			</svg>
		</div>

		<!-- Cute Mini Desktop Icons (Sticky corner on desktop, quick launcher on mobile) -->
		<div class="desktop-shortcuts z-20 flex lg:flex-col flex-row gap-5 lg:gap-6 justify-center items-center lg:absolute lg:top-16 lg:left-8 mb-6 lg:mb-0">
			<!-- about.txt -->
			<a
				href="#about-us"
				class="desktop-icon group flex flex-col items-center gap-1.5 focus:outline-none transition-transform duration-150 hover:-translate-y-1"
				title="Read about Girls in Tech"
			>
				<div class="w-12 h-12 flex items-center justify-center p-1 rounded-lg bg-base-100/60 border border-base-content/20 shadow-xs group-hover:bg-white group-hover:border-base-content group-hover:shadow-[2px_2px_0px_#3d0824] transition-all">
					<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M8 4H25L33 12V36H8V4Z" fill="#FFFDF8" stroke="#3D0824" stroke-width="2" stroke-linejoin="round"/>
						<path d="M25 4V12H33" fill="#FBBBD8" stroke="#3D0824" stroke-width="2" stroke-linejoin="round"/>
						<line x1="13" y1="17" x2="26" y2="17" stroke="#3D0824" stroke-width="2" stroke-linecap="round"/>
						<line x1="13" y1="22" x2="28" y2="22" stroke="#3D0824" stroke-width="2" stroke-linecap="round"/>
						<line x1="13" y1="27" x2="21" y2="27" stroke="#3D0824" stroke-width="2" stroke-linecap="round"/>
					</svg>
				</div>
				<span class="font-mono text-xs font-bold px-1.5 py-0.5 rounded text-base-content tracking-tight group-hover:bg-[#0055ea] group-hover:text-white transition-colors">
					about.txt
				</span>
			</a>

			<!-- events.exe -->
			<a
				href="/events"
				class="desktop-icon group flex flex-col items-center gap-1.5 focus:outline-none transition-transform duration-150 hover:-translate-y-1"
				title="View upcoming events"
			>
				<div class="w-12 h-12 flex items-center justify-center p-1 rounded-lg bg-base-100/60 border border-base-content/20 shadow-xs group-hover:bg-white group-hover:border-base-content group-hover:shadow-[2px_2px_0px_#3d0824] transition-all">
					<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="6" y="6" width="28" height="28" rx="2" fill="#FFFDF8" stroke="#3D0824" stroke-width="2"/>
						<rect x="7" y="7" width="26" height="7" fill="#0055EA"/>
						<circle cx="10.5" cy="10.5" r="1.5" fill="#FFFFFF"/>
						<path d="M13 19H27M13 24H27M13 29H20" stroke="#3D0824" stroke-width="1.8" stroke-linecap="round"/>
						<path d="M26 24L27 26.5L29.5 27.5L27 28.5L26 31L25 28.5L22.5 27.5L25 26.5L26 24Z" fill="#F69DC4" stroke="#3D0824" stroke-width="1"/>
					</svg>
				</div>
				<span class="font-mono text-xs font-bold px-1.5 py-0.5 rounded text-base-content tracking-tight group-hover:bg-[#0055ea] group-hover:text-white transition-colors">
					events.exe
				</span>
			</a>

			<!-- join.bat -->
			<a
				href="/contact"
				class="desktop-icon group flex flex-col items-center gap-1.5 focus:outline-none transition-transform duration-150 hover:-translate-y-1"
				title="Join Girls in Tech"
			>
				<div class="w-12 h-12 flex items-center justify-center p-1 rounded-lg bg-base-100/60 border border-base-content/20 shadow-xs group-hover:bg-white group-hover:border-base-content group-hover:shadow-[2px_2px_0px_#3d0824] transition-all">
					<svg class="w-8 h-8" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="6" y="6" width="28" height="28" rx="2" fill="#3D0824" stroke="#3D0824" stroke-width="2"/>
						<rect x="7" y="7" width="26" height="5" fill="#5A1539"/>
						<path d="M12 18L16 21L12 24" stroke="#4EF2BB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<line x1="18" y1="24" x2="25" y2="24" stroke="#FFD8E8" stroke-width="2" stroke-linecap="round"/>
						<circle cx="27" cy="18" r="2" fill="#F69DC4"/>
					</svg>
				</div>
				<span class="font-mono text-xs font-bold px-1.5 py-0.5 rounded text-base-content tracking-tight group-hover:bg-[#0055ea] group-hover:text-white transition-colors">
					join.bat
				</span>
			</a>
		</div>

		<div class="hero-content flex-col lg:flex-row gap-8 lg:gap-14 relative z-10 px-4">
			<!-- Logo Artwork with subtle separation glow -->
			<div class="relative max-w-lg w-full flex justify-center items-center">
				<div class="pointer-events-none absolute -inset-6 bg-white/35 rounded-full blur-2xl"></div>
				<Image
					alt="Girls in Tech UBC Okanagan"
					src={gitLogo}	
					class="relative max-w-lg w-full drop-shadow-[0_12px_24px_rgba(61,8,36,0.12)] transition-transform duration-300 hover:scale-[1.02]"
				/>
			</div>

			<!-- Hero Content & CTAs -->
			<div class="flex flex-col items-start max-w-xl">
				<!-- Eyebrow Tag -->
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-100/90 text-xs font-mono font-bold text-base-content mb-3 shadow-xs">
					<span class="text-primary animate-pulse">🌸</span>
					<span>University of British Columbia · Okanagan</span>
				</div>

				<div class="awesome-title">
					<h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-base-content">Girls in Tech!</h1>
				</div>

				<p class="py-5 text-base sm:text-lg leading-relaxed text-base-content/90 font-body">
					We aim to bridge the gap between girls in technology-related fields and the opportunities available for them.
				</p>

				<!-- Dual Call-to-Action -->
				<div class="flex flex-wrap items-center gap-4 pt-1">
					<a href="/contact" class="btn btn-primary btn-tactile text-white font-bold gap-2 text-base px-6">
						<span>Join the Club</span>
						<span>🌸</span>
					</a>
					<a href="/events" class="btn btn-outline btn-tactile font-bold gap-2 text-base px-6 group">
						<span>Explore Events</span>
						<span class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span>
					</a>
				</div>
			</div>
		</div>
	</div>
	<!-- About us -->
	<section id="about-us" class="about-us-section relative py-20 px-6 sm:px-10 lg:px-16 overflow-hidden">
		<!-- Subtle ambient glow background -->
		<div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[650px] max-w-full h-[320px] bg-gradient-to-b from-primary/15 via-secondary/10 to-transparent rounded-full blur-3xl opacity-70"></div>

		<!-- Section Heading -->
		<div class="about-header text-center mb-14 relative z-10">	
			<h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-header tracking-tight">About us</h2>
			<div class="about-header-line w-20 h-1 bg-primary/40 mx-auto mt-4 rounded-full"></div>
		</div>

		<!-- Paragraph pieces container with 3D perspective -->
		<div class="about-perspective relative max-w-4xl mx-auto z-10 flex flex-col gap-8 md:gap-10">
			<!-- Timeline Track Line -->
			<div class="about-progress-line absolute left-4 sm:left-6 top-6 bottom-6 w-[2px] bg-gradient-to-b from-primary via-secondary to-accent/40 rounded-full hidden md:block origin-top opacity-30"></div>

			<!-- 1st card -->
			<article class="about-piece group relative md:pl-14 transition-all duration-300">
				<!-- Decorative Node Marker for Desktop Track -->
				<div class="absolute left-4 sm:left-6 top-8 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-base-100 border-2 border-primary shadow-xs hidden md:flex items-center justify-center">
					<div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
				</div>

				<div class="about-card p-6 sm:p-8 rounded-2xl bg-base-100/80 border border-base-300 shadow-md backdrop-blur-sm transition-all duration-300 hover:shadow-lg hover:border-primary/40">
					<div class="flex items-center justify-between gap-4 mb-4">
						<span class="about-piece-badge font-mono text-xs font-bold tracking-wider uppercase text-primary/90 flex items-center gap-1.5">
							<span class="opacity-60">//</span> 01 · WHO WE ARE
						</span>
						<span class="text-xs font-mono opacity-50">Community</span>
					</div>
					<div class="about-piece-line w-12 h-0.5 bg-primary/40 mb-4 origin-left"></div>
					<p class="text-base sm:text-lg leading-relaxed text-base-content/90 font-body">
						SUO Girls in Tech at UBCO provides an inclusive and welcoming space for diversity in technology. We are a student-led club located at the University of British Columbia's Okanagan Campus.
					</p>
				</div>
			</article>

			<!-- 2nd card -->
			<article class="about-piece group relative md:pl-14 transition-all duration-300">
				<!-- Decorative Node Marker for Desktop Track -->
				<div class="absolute left-4 sm:left-6 top-8 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-base-100 border-2 border-secondary shadow-xs hidden md:flex items-center justify-center">
					<div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
				</div>

				<div class="about-card p-6 sm:p-8 rounded-2xl bg-base-100/80 border border-base-300 shadow-md backdrop-blur-sm transition-all duration-300 hover:shadow-lg hover:border-secondary/40">
					<div class="flex items-center justify-between gap-4 mb-4">
						<span class="about-piece-badge font-mono text-xs font-bold tracking-wider uppercase text-secondary/90 flex items-center gap-1.5">
							<span class="opacity-60">//</span> 02 · EVENTS & EMPOWERMENT
						</span>
						<span class="text-xs font-mono opacity-50">Skills & Network</span>
					</div>
					<div class="about-piece-line w-12 h-0.5 bg-secondary/40 mb-4 origin-left"></div>
					<p class="text-base sm:text-lg leading-relaxed text-base-content/90 font-body">
						Throughout the school year, we will be hosting a variety of events for students. This includes: career prep activities like hackathons and pitch events, socials where you can connect with students and professionals in the technology field, workshops and programs to build your technical skills, and more!
					</p>
				</div>
			</article>

			<!-- 3rd card -->
			<article class="about-piece group relative md:pl-14 transition-all duration-300">
				<!-- Decorative Node Marker for Desktop Track -->
				<div class="absolute left-4 sm:left-6 top-8 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-base-100 border-2 border-primary shadow-xs hidden md:flex items-center justify-center">
					<div class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></div>
				</div>

				<div class="about-card p-6 sm:p-8 rounded-2xl from-base-100 via-base-200/50 to-base-100 border-2 border-primary/30 shadow-lg backdrop-blur-sm transition-all duration-300 hover:shadow-xl hover:border-primary/60">
					<div class="flex items-center justify-between gap-4 mb-4">
						<span class="about-piece-badge font-mono text-xs font-bold tracking-wider uppercase text-primary flex items-center gap-1.5">
							<span class="opacity-60">//</span> 03 · JOIN OUR JOURNEY
						</span>
						<span class="text-xs font-mono opacity-50">UBCO Community</span>
					</div>
					<div class="about-piece-line w-16 h-0.5 bg-primary/60 mb-4 origin-left"></div>
					<h3 class="text-xl sm:text-2xl md:text-3xl font-header font-bold text-base-content leading-snug">
						We look forward to meeting you and supporting your tech career!
					</h3>
				</div>
			</article>
		</div>
	</section>
	<!-- FeaturedEvent component insert -->
	 <div class="min-h-[50vh] px-4 md:px-8 py-8">
		<h1 class="text-5xl text-center mt-[2vh] mb-8">Featured Event</h1>
		<div class="gap-8 max-w-7xl mx-auto">
			{featured.map((event) => (
				<Event 
					eventTitle = {event.data.title}
					imgs = {event.data.imgs}
					description = {event.data.description}
				/>
			))}
		</div>
	 </div>
	 <!-- Sponsor block -->
	 <div class="mt-[4vh]">
		<h2 class="text-3xl text-center">Thanks to our sponsors!</h2>
		{sponsors.map((sponsor) => (
			<Sponsor
				name = {sponsor.data.name}
				description = {sponsor.data.description}
				img = {sponsor.data.img}
				address = {sponsor.data.address}
				contact = {sponsor.data.contact}
			/>
		))}
	 </div>
</Layout>

<script>
	import { animate, createTimeline, onScroll, stagger, splitText } from 'animejs';

	const setupAnimations = () => {
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 1. awesome-title bouncing characters animation
		const titleElement = document.querySelector<HTMLElement>('.awesome-title h1');
		if (titleElement && !prefersReducedMotion) {
			const titleChars = splitText(titleElement, { words: false, chars: true });
			if (titleChars && titleChars.chars && titleChars.chars.length) {
				animate(titleChars.chars, {
					translateY: [
						{ to: '-2.75rem', ease: 'outExpo', duration: 550 },
						{ to: '0rem', ease: 'outBounce', duration: 750 }
					],
					rotate: {
						from: '-1turn',
						to: '0turn',
						duration: 700,
						ease: 'outExpo',
					},
					delay: stagger(60),
					loopDelay: 2000,
					loop: true,
				});
			}
		}

		// 2. About section animation with createTimeline + onScroll
		const aboutSection = document.getElementById('about-us');
		if (!aboutSection) return;

		const pieces = aboutSection.querySelectorAll<HTMLElement>('.about-piece');
		const header = aboutSection.querySelector<HTMLElement>('.about-header');
		const headerLine = aboutSection.querySelector<HTMLElement>('.about-header-line');
		const progressLine = aboutSection.querySelector<HTMLElement>('.about-progress-line');

		if (prefersReducedMotion) {
			pieces.forEach((p) => {
				p.style.opacity = '1';
				p.style.transform = 'none';
				p.style.filter = 'none';
			});
			return;
		}

		// Section header timeline createTimeline
		if (header) {
			const headerTl = createTimeline({
				autoplay: onScroll({
					target: header,
					enter: '85% top',
					leave: '15% bottom',
					sync: 'play reverse',
				}),
				defaults: {
					ease: 'outExpo',
				},
			});

			headerTl.add(header, {
				opacity: [0, 1],
				translateY: [40, 0],
				filter: ['blur(10px)', 'blur(0px)'],
				duration: 900,
			});

			if (headerLine) {
				headerTl.add(
					headerLine,
					{
						scaleX: [0, 1],
						opacity: [0, 1],
						duration: 800,
					},
					'-=600'
				);
			}
		}

		// Vertical progress track linked to scroll scrubbing
		if (progressLine) {
			animate(progressLine, {
				scaleY: [0, 1],
				opacity: [0.1, 0.7],
				duration: 1000,
				ease: 'linear',
				autoplay: onScroll({
					target: aboutSection,
					enter: '75% top',
					leave: '25% bottom',
					sync: 0.5,
				}),
			});
		}

		// Each paragraph piece orchestrated with createTimeline
		pieces.forEach((piece) => {
			const badge = piece.querySelector<HTMLElement>('.about-piece-badge');
			const line = piece.querySelector<HTMLElement>('.about-piece-line');
			const node = piece.querySelector<HTMLElement>('.rounded-full');

			const pieceTl = createTimeline({
				autoplay: onScroll({
					target: piece,
					enter: '85% top',
					leave: '15% bottom',
					sync: 'play reverse',
				}),
				defaults: {
					ease: 'outExpo',
				},
			});

			// Main card 3D rack-focus glide
			pieceTl.add(piece, {
				opacity: [0, 1],
				translateY: [55, 0],
				rotateX: [10, 0],
				scale: [0.93, 1],
				filter: ['blur(12px)', 'blur(0px)'],
				duration: 950,
			});

			// Track node pop
			if (node) {
				pieceTl.add(
					node,
					{
						scale: [0.3, 1],
						opacity: [0, 1],
						duration: 600,
						ease: 'outBack(2)',
					},
					'-=800'
				);
			}

			// Subtitle badge slide-in
			if (badge) {
				pieceTl.add(
					badge,
					{
						opacity: [0, 1],
						translateX: [-18, 0],
						duration: 700,
					},
					'-=700'
				);
			}

			// Underline unfold
			if (line) {
				pieceTl.add(
					line,
					{
						scaleX: [0, 1],
						opacity: [0, 1],
						duration: 750,
					},
					'-=650'
				);
			}
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupAnimations);
	} else {
		setupAnimations();
	}
	document.addEventListener('astro:page-load', setupAnimations);
</script>

<style>
	.about-perspective {
		perspective: 1200px;
		transform-style: preserve-3d;
	}

	.about-piece {
		transform-style: preserve-3d;
		will-change: transform, opacity, filter;
	}

	.awesome-title :global([data-char]),
	.awesome-title :global(span) {
		display: inline-block;
		will-change: transform;
	}
</style>
