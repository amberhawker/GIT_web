---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{png,jpg,jpeg,webp,gif}',
  { eager: true }
);

const images = Object.entries(imageFiles).map(([path, module]) => {
  const filename = path.split('/').pop() || 'photo.jpg';
  return {
    data: module.default,
    filename,
  };
});

const tilts = [
  'card-tilt-1',
  'card-tilt-2',
  'card-tilt-3',
  'card-tilt-4',
  'card-tilt-5',
  'card-tilt-6',
];
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    <!-- Page Header with Retro Accents -->
    <div class="text-center mb-10 relative">
      <!-- Retro Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-base-100 border border-base-content/20 text-xs font-mono font-bold text-base-content mb-3 shadow-xs">
        <span class="text-primary animate-pulse">🌸</span>
        <span>C:\GIRLS_IN_TECH\ALBUM · {images.length} PHOTOS ARCHIVED</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-header tracking-tight text-base-content">
        Club Gallery
      </h1>
      <p class="mt-3 text-base sm:text-lg font-body text-base-content/85 max-w-xl mx-auto leading-relaxed">
        Memories, hackathons, workshops, and good times with the Girls in Tech community at UBCO.
      </p>
    </div>

    <!-- Polaroid Photos Flex Showcase (Directly on Page) -->
    <div class="flex flex-wrap gap-8 justify-center items-center py-4 max-w-6xl mx-auto">
      {images.map((img, index) => {
        const tilt = tilts[index % tilts.length];
        return (
          <div
            class:list={[
              "gallery-card group relative p-3 pb-3.5 bg-white rounded-xs border-2 border-base-content shadow-[4px_4px_0px_#3d0824] cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary z-10 hover:z-30",
              tilt
            ]}
            data-img-src={img.data.src}
            data-img-name={img.filename}
            data-img-dims={`${img.data.width} × ${img.data.height} px`}
            tabindex="0"
            role="button"
            aria-label={`View photo ${img.filename}`}
          >
            <!-- Washi Tape strip -->
            <div class="tape-strip pointer-events-none absolute -top-2.5 left-1/2 -translate-x-1/2 w-14 h-4 border border-base-content/20 -rotate-2 z-20"></div>

            <!-- Photo Container with natural aspect ratio -->
            <div
              class="relative overflow-hidden bg-base-300 rounded-xs border border-base-content/25 h-48 sm:h-56 md:h-64 max-h-[300px]"
              style={{ aspectRatio: `${img.data.width} / ${img.data.height}` }}
            >
              <Image
                src={img.data}
                alt={img.filename}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />

              <!-- Hover viewfinder badge -->
              <div class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/65 text-white font-mono text-[9px] tracking-wider uppercase opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 pointer-events-none">
                <span>🔍</span>
                <span>VIEW</span>
              </div>
            </div>

            <!-- Bottom Polaroid Caption / Label -->
            <div class="mt-2.5 pt-1.5 border-t border-base-content/10 flex items-center justify-between gap-2 text-base-content select-none">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="text-xs">📸</span>
                <span class="font-mono text-xs font-bold truncate max-w-[150px]">{img.filename}</span>
              </div>
              <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-base-200 text-base-content/80 font-bold uppercase">
                {img.data.format}
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Gallery Bottom Status Bar -->
    <div class="mt-12 pt-6 border-t border-base-content/20 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-base-content/75 select-none max-w-5xl mx-auto">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        <span>{images.length} photo(s) indexed</span>
        <span class="opacity-40">|</span>
        <span>Disk: UBCO_GIT (C:)</span>
      </div>
      <div class="flex items-center gap-2 text-[11px] opacity-80">
        <span>🌸 Girls in Tech Memories</span>
        <span class="opacity-40">|</span>
        <span>Kelowna, BC</span>
      </div>
    </div>

    <!-- Interactive Lightbox Modal (Windows Picture and Fax Viewer) -->
    <dialog id="gallery_modal" class="modal bg-black/60 backdrop-blur-xs p-4">
      <div class="modal-box p-0 max-w-4xl bg-transparent shadow-none border-0 overflow-visible">
        <div
          class="mockup-window bg-base-100 border-2 border-base-content shadow-[8px_8px_0px_#3d0824]"
          data-title="Windows Picture and Fax Viewer"
        >
          <div class="p-4 sm:p-6 bg-base-100 flex flex-col items-center">
            <!-- Image Canvas -->
            <div class="w-full max-h-[65vh] flex items-center justify-center overflow-hidden rounded bg-base-200/50 border border-base-content/20 p-2 sm:p-4">
              <img
                id="modal_image"
                src=""
                alt="Enlarged photo preview"
                class="max-h-[60vh] max-w-full w-auto object-contain rounded shadow-xs"
              />
            </div>

            <!-- Footer Details & Close Button -->
            <div class="w-full mt-4 pt-3 border-t border-base-300 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-bold text-base-content truncate" id="modal_filename">photo.jpg</span>
                <span class="text-base-content/60 text-[11px]" id="modal_dims"></span>
              </div>
              <form method="dialog">
                <button class="btn btn-sm btn-tactile btn-primary font-mono text-xs">
                  Close [X]
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  const setupGalleryModal = () => {
    const modal = document.getElementById('gallery_modal') as HTMLDialogElement | null;
    const modalImg = document.getElementById('modal_image') as HTMLImageElement | null;
    const modalFilename = document.getElementById('modal_filename');
    const modalDims = document.getElementById('modal_dims');
    const cards = document.querySelectorAll<HTMLElement>('.gallery-card');

    if (!modal || !modalImg) return;

    cards.forEach((card) => {
      if (card.dataset.hasListener) return;
      card.dataset.hasListener = 'true';

      const openModal = () => {
        const src = card.dataset.imgSrc;
        const name = card.dataset.imgName;
        const dims = card.dataset.imgDims;
        if (src) {
          modalImg.src = src;
          if (modalFilename) modalFilename.textContent = name || 'photo';
          if (modalDims) modalDims.textContent = dims ? `(${dims})` : '';
          modal.showModal();
        }
      };

      card.addEventListener('click', openModal);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal();
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGalleryModal);
  } else {
    setupGalleryModal();
  }
  document.addEventListener('astro:page-load', setupGalleryModal);
</script>

<style>
  .card-tilt-1 {
    transform: rotate(-1.5deg);
  }
  .card-tilt-2 {
    transform: rotate(1.5deg);
  }
  .card-tilt-3 {
    transform: rotate(-2deg);
  }
  .card-tilt-4 {
    transform: rotate(2deg);
  }
  .card-tilt-5 {
    transform: rotate(-1deg);
  }
  .card-tilt-6 {
    transform: rotate(1.2deg);
  }

  .gallery-card {
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s ease;
    will-change: transform;
  }

  .gallery-card:hover {
    transform: translateY(-8px) rotate(0deg) scale(1.02);
    box-shadow: 7px 7px 0px #3d0824;
  }

  .gallery-card:active {
    transform: translateY(-2px) rotate(0deg) scale(1);
    box-shadow: 3px 3px 0px #3d0824;
  }

  .tape-strip {
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(2px);
  }
</style>