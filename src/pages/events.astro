---
import Layout from '../layouts/Layout.astro';
import Event from '../components/Event.astro';

import { getCollection } from 'astro:content';

const allEvents = await getCollection("events");
---

<Layout>
    <div class="mt-[3vh]">
        <div>
            <!--has the start of the page -->
            <h1 class="text-3xl font-bold text-center">Hey dude</h1>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-7xl mx-auto px-4 md:px-8 my-8">
            <!--all events TODO: make sure they're sorted by date? Astro says it's non-deterministic -->
            {allEvents.map((event) => (
                <Event
                    eventTitle={event.data.title}
                    imgs={event.data.imgs}
                    description={event.data.description}
                />
            ))}
        </div>
    </div>
</Layout>