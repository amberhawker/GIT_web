---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';

const authed = Astro.locals.adminAuthed;
---

<Layout title="Admin">
	<main class="admin-page">
		<header class="admin-header">
			<div>
				<p class="admin-kicker">UBCO Girls in Tech</p>
				<h1 class="admin-title">Admin</h1>
				<p class="admin-subtitle">Edit events, team, and gallery. Pushed to Github on save.</p>
			</div>
			{
				authed && (
					<div class="flex flex-wrap gap-2">
						<button id="logout-btn" class="btn btn-outline btn-sm font-mono" type="button">
							Log out
						</button>
						<button
							id="logout-all-btn"
							class="btn btn-ghost btn-sm font-mono"
							type="button"
							title="Revoke every active admin session (all devices)"
						>
							Log out everywhere
						</button>
					</div>
				)
			}
		</header>

		{
			!authed ? (
				<form id="login-form" class="admin-login">
					<p class="admin-status">Enter the shared site password.</p>
					<label class="admin-field">
						<span class="admin-label">Password</span>
						<input
							type="password"
							name="password"
							required
							autocomplete="current-password"
							class="admin-input"
						/>
					</label>
					<p id="login-error" class="admin-status is-err hidden"></p>
					<button class="btn btn-primary btn-tactile text-white font-mono font-bold" type="submit">
						Log in
					</button>
				</form>
			) : (
				<div id="admin-dashboard" class="admin-dashboard">
					<div role="tablist" class="admin-tabs" aria-label="Admin sections">
						<button type="button" role="tab" class="admin-tab tab-active" data-tab="events" aria-selected="true">
							Events
						</button>
						<button type="button" role="tab" class="admin-tab" data-tab="execs" aria-selected="false">
							Team
						</button>
						<button type="button" role="tab" class="admin-tab" data-tab="gallery" aria-selected="false">
							Gallery
						</button>
					</div>

					<section data-panel="events" class="admin-panel">
						<div class="admin-split">
							<aside class="admin-picker">
								<div class="admin-toolbar-actions">
									<button id="event-new" type="button" class="btn btn-sm btn-tactile font-mono">New</button>
									<button id="event-delete" type="button" class="btn btn-sm btn-ghost text-error font-mono">
										Delete
									</button>
								</div>
								<div id="events-list" class="admin-item-list" role="listbox" aria-label="Events"></div>
								<p id="events-status" class="admin-status">Loading…</p>
							</aside>
						<form id="event-form" class="admin-form">
							<label class="admin-field">
								<span class="admin-label">id (filename)</span>
								<input name="id" class="admin-input" required placeholder="hackattack" />
							</label>
							<label class="admin-field">
								<span class="admin-label">title</span>
								<input name="title" class="admin-input" required />
							</label>
							<label class="admin-field">
								<span class="admin-label">date</span>
								<input name="date" class="admin-input" />
							</label>
							<label class="admin-field admin-field-check">
								<span class="admin-label">featured</span>
								<span class="admin-check-row">
									<input name="featured" type="checkbox" class="checkbox border-2 border-base-content" />
									<span class="admin-label admin-muted">Show on homepage</span>
								</span>
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">description</span>
								<textarea name="description" class="admin-textarea"></textarea>
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">images (one per line: path | alt)</span>
								<textarea
									name="imgs"
									class="admin-textarea font-mono text-sm"
									placeholder="/assets/events/hackattack.png | Hack Attack"
								></textarea>
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">upload images (optional)</span>
								<input name="files" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple class="admin-file" />
							</label>
							<div
								id="events-progress"
								class="admin-progress admin-field-full hidden"
								role="progressbar"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
								aria-label="Event image upload progress"
							>
								<div class="admin-progress-bar"></div>
							</div>
							<div class="admin-field-full">
								<button class="btn btn-primary btn-tactile text-white font-mono font-bold" type="submit">
									Save event
								</button>
							</div>
						</form>
						</div>
					</section>

					<section data-panel="execs" class="admin-panel hidden">
						<div class="admin-split">
							<aside class="admin-picker">
								<div class="admin-toolbar-actions">
									<button id="exec-new" type="button" class="btn btn-sm btn-tactile font-mono">New</button>
									<button id="exec-delete" type="button" class="btn btn-sm btn-ghost text-error font-mono">
										Delete
									</button>
								</div>
								<div id="execs-list" class="admin-item-list" role="listbox" aria-label="Team members"></div>
								<p id="execs-status" class="admin-status">Loading…</p>
							</aside>
						<form id="exec-form" class="admin-form">
							<label class="admin-field">
								<span class="admin-label">id (filename)</span>
								<input name="id" class="admin-input" required placeholder="president" />
							</label>
							<label class="admin-field">
								<span class="admin-label">role</span>
								<input name="role" class="admin-input" required />
							</label>
							<label class="admin-field">
								<span class="admin-label">name</span>
								<input name="name" class="admin-input" required />
							</label>
							<label class="admin-field">
								<span class="admin-label">degree</span>
								<input name="degree" class="admin-input" required />
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">description</span>
								<textarea name="description" class="admin-textarea admin-textarea-sm" required></textarea>
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">primary img path</span>
								<input name="img" class="admin-input font-mono text-sm" placeholder="/assets/execs/name.jpg" />
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">imgs stack (one per line: path | alt)</span>
								<textarea name="imgs" class="admin-textarea font-mono text-sm"></textarea>
							</label>
							<label class="admin-field admin-field-full">
								<span class="admin-label">upload images (optional)</span>
								<input name="files" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple class="admin-file" />
							</label>
							<div
								id="execs-progress"
								class="admin-progress admin-field-full hidden"
								role="progressbar"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
								aria-label="Exec image upload progress"
							>
								<div class="admin-progress-bar"></div>
							</div>
							<div class="admin-field-full">
								<button class="btn btn-primary btn-tactile text-white font-mono font-bold" type="submit">
									Save exec
								</button>
							</div>
						</form>
						</div>
					</section>

					<section data-panel="gallery" class="admin-panel admin-panel-gallery hidden">
						<p id="gallery-status" class="admin-status"></p>
						<form id="gallery-form" class="admin-form admin-form-upload">
							<label class="admin-field">
								<span class="admin-label">upload images</span>
								<input name="files" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple class="admin-file" />
							</label>
							<button class="btn btn-primary btn-tactile text-white font-mono font-bold" type="submit">
								Upload
							</button>
							<div
								id="gallery-progress"
								class="admin-progress hidden"
								role="progressbar"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
								aria-label="Gallery upload progress"
							>
								<div class="admin-progress-bar"></div>
							</div>
						</form>
						<div id="gallery-grid" class="admin-gallery-grid"></div>
					</section>
				</div>
			)
		}
	</main>
</Layout>

<script>
	import { initAdminDashboard } from '../../components/admin/admin-client';

	const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
	const loginError = document.getElementById('login-error');
	const logoutBtn = document.getElementById('logout-btn');

	loginForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		loginError?.classList.add('hidden');
		if (loginError) loginError.textContent = '';

		const password = String(new FormData(loginForm).get('password') ?? '');
		const res = await fetch('/api/admin/login', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ password }),
		});

		if (!res.ok) {
			const body = (await res.json().catch(() => ({}))) as { error?: string };
			if (loginError) {
				loginError.textContent = body.error ?? 'Login failed';
				loginError.classList.remove('hidden');
			}
			return;
		}
		window.location.reload();
	});

	logoutBtn?.addEventListener('click', async () => {
		await fetch('/api/admin/logout', { method: 'POST' });
		window.location.reload();
	});

	document.getElementById('logout-all-btn')?.addEventListener('click', async () => {
		if (!confirm('Log out every admin session on all devices?')) return;
		await fetch('/api/admin/logout?all=1', { method: 'POST' });
		window.location.reload();
	});

	const root = document.getElementById('admin-dashboard');
	if (root) initAdminDashboard(root);
</script>
