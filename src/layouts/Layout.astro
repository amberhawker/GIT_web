---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href="/fonts/Redaction_50-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Redaction_50-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/NaturalMono-Regular.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="preload" href="/fonts/NaturalMono-Bold.ttf" as="font" type="font/ttf" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>UBCO Girls in Tech</title>
	</head>
	<body class="relative min-h-screen">
		<!-- Global Retro Sparkles / Stars -->
		<div class="pointer-events-none fixed inset-0 overflow-hidden z-20 select-none" aria-hidden="true">
			<!-- Top Left -->
			<div class="absolute top-20 left-6 sm:top-24 sm:left-12 text-primary opacity-75 animate-pulse">
				<svg class="w-6 h-6 sm:w-7 sm:h-7 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>

			<!-- Top Right -->
			<div class="absolute top-24 right-6 sm:top-28 sm:right-16 text-primary opacity-80 animate-pulse [animation-delay:1100ms]">
				<svg class="w-7 h-7 sm:w-8 sm:h-8 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>

			<!-- Mid Left (Desktop) -->
			<div class="hidden md:block absolute top-1/2 left-8 -translate-y-1/2 text-base-content/30 opacity-60 animate-pulse [animation-delay:600ms]">
				<svg class="w-5 h-5 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>

			<!-- Mid Right (Desktop) -->
			<div class="hidden lg:block absolute top-1/2 right-10 -translate-y-1/2 text-primary/70 opacity-70 animate-pulse [animation-delay:1500ms]">
				<svg class="w-5 h-5 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>

			<!-- Bottom Left -->
			<div class="absolute bottom-12 left-6 sm:bottom-16 sm:left-14 text-base-content/40 opacity-70 animate-pulse [animation-delay:800ms]">
				<svg class="w-5 h-5 sm:w-6 sm:h-6 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>

			<!-- Bottom Right -->
			<div class="absolute bottom-10 right-8 sm:bottom-16 sm:right-20 text-primary/80 opacity-75 animate-pulse [animation-delay:1800ms]">
				<svg class="w-6 h-6 sm:w-7 sm:h-7 drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C12 7 7 12 0 12C7 12 12 17 12 24C12 17 17 12 24 12C17 12 12 7 12 0Z"/>
				</svg>
			</div>
		</div>

		<Header />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
