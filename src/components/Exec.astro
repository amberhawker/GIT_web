---
import { Image } from 'astro:assets';

interface Props {
  role: string,
  name: string,
  img: string,
  degree: string,
  description: string
}

const {
  role = "",
  name = "",
  img = "/assets/execs/placeholder.jpg",
  degree = "",
  description = ""
} = Astro.props;

---

<div class="exec-card mockup-window bg-base-100 border border-base-300 w-full h-full flex flex-col justify-between" data-title={name ? `${name} - ${role}` : (role || "Girls in Tech")}>
    <div class="flex flex-col sm:flex-row items-center sm:items-start md:items-center justify-start gap-4 sm:gap-6 p-4 sm:p-5 md:p-6 flex-1">
        <div class="relative w-24 h-32 sm:w-28 sm:h-[9.33rem] md:w-32 md:h-[10.67rem] shrink-0 aspect-[3/4] self-center sm:self-start md:self-center">
            <div class="photo-stack stack w-full h-full bg-base-300 rounded-box shadow-md">
                <Image
                    alt={name}
                    src={img}
                    width={450}
                    height={600}
                    class="rounded-box w-full h-full object-cover object-top"
                />
            </div>
        </div>
        <div class="flex flex-col justify-center text-center sm:text-left flex-1 min-w-0">
            <h3 class="text-xl sm:text-2xl font-bold mb-1 leading-snug">{role}</h3>
            <p class="font-bold text-sm sm:text-base text-base-content mb-1">{name}</p>
            <p class="text-xs sm:text-sm text-base-content/80 leading-relaxed">
                <span class="font-semibold text-base-content/90">{degree}</span>
                {description && (
                    <>
                        <br/>
                        <span>{description}</span>
                    </>
                )}
            </p>
        </div>
    </div>
</div>