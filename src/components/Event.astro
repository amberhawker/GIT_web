---
import { Image } from 'astro:assets';

interface Img {
  path: string;
  alt?: string;
}

interface Props {
  eventTitle: string;
  imgs: Array<Img>;
  description: string;
}

const {
  eventTitle = "Girls in Tech",
  imgs = [
    { path: '/assets/animatedgit.gif', alt: "animated git logo" },
    { path: '/assets/GITInit.png', alt: "git logo" }
  ],
  description = "Girls in Tech (default value)"
} = Astro.props;
---

<div class="event-card mockup-window bg-base-100 border border-base-300 w-full h-full flex flex-col justify-between" data-title={eventTitle}>
  <!-- Horizontal layout for photos and description/title -->
  <div class="flex flex-col xl:flex-row items-start xl:items-center justify-start gap-6 p-6 md:p-8 flex-1">
    <!-- Photo Stack Container with button layered on top of photos -->
    <div class="relative w-full xl:w-64 aspect-3/2 shrink-0">
      <div class="photo-stack stack w-full h-full bg-base-300 rounded-box shadow-md">
        {imgs.map((img) => (
          <Image
            alt={img.alt || eventTitle}
            src={img.path}
            width={600}
            height={400}
            class="rounded-box w-full h-full object-cover"
          />
        ))}
      </div>

      <!-- Button layered directly on top of the photos -->
      <button 
        type="button" 
        class="next-btn btn btn-primary btn-sm absolute bottom-2 right-2 z-20 shadow-md"
        aria-label="Next photo"
      >
        ❯
      </button>
    </div>

    <div class="divider divider-horizontal hidden xl:flex self-stretch"></div>
    <div class="divider divider-vertical xl:hidden my-0"></div>

    <!-- Title and Description horizontal to the photos -->
    <div class="flex flex-col justify-center text-left flex-1 min-w-0">
      <h3 class="text-2xl md:text-3xl font-bold mb-2">{eventTitle}</h3>
      <p class="text-base text-base-content/80 leading-relaxed">{description}</p>
    </div>
  </div>
</div>

<script>
  import { animate, stagger } from 'animejs';

  const setupEventCards = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.event-card.mockup-window'));

    if (!cards.length) return;

    // 1. Photo stack button handler
    cards.forEach((card) => {
      if (!card.dataset.initialized) {
        card.dataset.initialized = 'true';
        const stack = card.querySelector('.photo-stack');
        const nextBtn = card.querySelector('.next-btn');

        nextBtn?.addEventListener('click', () => {
          if (stack && stack.firstElementChild) {
            stack.appendChild(stack.firstElementChild);
          }
        });
      }
    });

    // 2. Old-web serial pop-in animation
    if (prefersReducedMotion) {
      cards.forEach((card) => {
        card.style.opacity = '1';
        card.style.transform = 'none';
        card.style.filter = 'none';
      });
      return;
    }

    // Group cards by their parent container so cards in the same grid/section animate in series
    const containers = new Set<HTMLElement>();
    cards.forEach((card) => {
      if (card.parentElement && !card.dataset.animated) {
        containers.add(card.parentElement);
      }
    });

    containers.forEach((container) => {
      const containerCards = Array.from(
        container.querySelectorAll<HTMLElement>('.event-card.mockup-window:not([data-animated="true"])')
      );

      if (!containerCards.length) return;

      // Prepare cards in initial hidden / scaled state
      containerCards.forEach((card) => {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.7) translateY(35px)';
        card.style.willChange = 'transform, opacity, filter';
      });

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);

              // Mark as animated to prevent re-triggering
              containerCards.forEach((c) => (c.dataset.animated = 'true'));

              // Old-web bouncy spring pop with CRT monitor phosphor brightness flash
              animate(containerCards, {
                opacity: [0, 1],
                scale: [0.7, 1],
                translateY: [35, 0],
                filter: [
                  'brightness(1.6) contrast(1.15)',
                  'brightness(1) contrast(1)'
                ],
                duration: 650,
                ease: 'outBack(2.2)',
                delay: stagger(200),
                onComplete: () => {
                  containerCards.forEach((card) => {
                    card.style.willChange = 'auto';
                    card.style.transform = '';
                    card.style.filter = '';
                  });
                }
              });
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -40px 0px'
        }
      );

      observer.observe(container);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupEventCards);
  } else {
    setupEventCards();
  }
  document.addEventListener('astro:page-load', setupEventCards);
</script>