---
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../lib/images';

interface Props {
    name: string,
    description: string,
    img: string,
    address?: string,
    contact?: string
}

const {
    name = "PLaceholder",
    description = "placeholder",
    img = "",
    address = "",
    contact = ""
} = Astro.props;

const resolvedImg = resolveAssetImage(img);
---

<div class="event-card mockup-browser bg-base-100 border border-base-300 mx-4 sm:mx-8 lg:mx-auto lg:max-w-5xl mt-6">
    <div class="flex flex-col md:flex-row items-start gap-4 md:gap-6 p-5 sm:p-6 md:p-8">
        <div class="relative w-full md:w-80 lg:w-96 aspect-3/2 shrink-0">
            <Image
                alt={name}
                src={resolvedImg}
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 60vh"
                class="object-cover w-full h-full"
            />
        </div>
        <div class="divider divider-horizontal hidden md:flex self-stretch" />
        <div class="flex flex-col text-left min-w-0 break-words">
            <h3 class="text-2xl sm:text-3xl font-bold mb-2">{name}</h3>
            <p>
                {description}
            </p>
            {address && <p class="mt-4">{address}</p>}
            {contact && <p class="mt-4 break-all">{contact}</p>}
        </div>
    </div>
</div>
